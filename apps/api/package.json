{
  "name": "@telehealth/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-transform-types src/index.ts",
    "start": "node --experimental-transform-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-transform-types --test \"src/**/*.test.ts\"",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --experimental-transform-types src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@neondatabase/serverless": "^0.10.4",
    "@trpc/server": "^11.0.0",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "superjson": "^2.2.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.7.3"
  }
}
