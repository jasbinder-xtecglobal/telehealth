{
  "name": "telehealth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:(web|server)$/\"",
    "dev:web": "vite",
    "dev:server": "pnpm --dir server dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --dir server typecheck",
    "test": "pnpm --dir server test",
    "db:migrate": "pnpm --dir server db:migrate",
    "db:push": "pnpm --dir server db:push",
    "db:seed": "pnpm --dir server db:seed",
    "db:studio": "pnpm --dir server db:studio",
    "db:reset": "pnpm db:push && pnpm db:seed",
    "setup": "pnpm install && pnpm --dir server install && pnpm db:reset"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@tanstack/react-query": "^5.64.2",
    "@trpc/client": "^11.0.0",
    "@trpc/tanstack-react-query": "^11.0.0",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.3",
    "superjson": "^2.2.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
