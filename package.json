{
  "name": "telehealth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @telehealth/api dev",
    "dev:web": "pnpm --filter @telehealth/web dev",
    "dev:site": "pnpm --filter @telehealth/site dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "db:migrate": "pnpm --filter @telehealth/api db:migrate",
    "db:push": "pnpm --filter @telehealth/api db:push",
    "db:seed": "pnpm --filter @telehealth/api db:seed",
    "db:studio": "pnpm --filter @telehealth/api db:studio",
    "db:intake": "pnpm --filter @telehealth/api exec node --experimental-transform-types scripts/apply-intake-schema.ts",
    "db:reset": "pnpm db:push && pnpm db:seed",
    "setup": "pnpm install && pnpm db:reset",
    "typecheck": "pnpm --filter \"./apps/*\" typecheck",
    "test": "pnpm --filter @telehealth/api test"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
