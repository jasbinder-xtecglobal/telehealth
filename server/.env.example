# Backend configuration — copy to `server/.env`.
#
# Nothing here reaches the browser. `src/config/env.ts` validates all of it at
# startup, so the API refuses to boot on a half-configured environment.

# Neon Postgres connection string.
#   1. Create a project at https://console.neon.tech
#   2. Connection Details → copy the *pooled* connection string
#
# Any Postgres connection string works — Neon is simply the default target.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

API_PORT=4000

# Comma-separated. The first entry is the origin patient call-join links are
# built from; the rest are additionally allowed as CORS origins.
WEB_ORIGIN=http://localhost:5173

NODE_ENV=development

# ---------------------------------------------------------------------------
# Call transport — LiveKit
#
# Optional. Leave these unset and the API still boots; LiveKit simply appears
# greyed out in the consult call picker, with the missing variables named.
#
#   1. Create a free project at https://cloud.livekit.io
#   2. Settings → Keys → copy the API key and secret
#   3. The URL is the project's wss:// endpoint, shown on the same page
#
# The secret is server-side only — the browser only ever receives a signed,
# expiring token scoped to one room. Never commit real values.
# ---------------------------------------------------------------------------
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
